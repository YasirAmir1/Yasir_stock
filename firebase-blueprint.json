{
  "entities": {
    "delegate_target": {
      "title": "Delegate Target",
      "description": "Daily target weight for delegate per category",
      "type": "object",
      "properties": {
        "delegateName": { "type": "string" },
        "categoryName": { "type": "string" },
        "dailyTargetWeightKg": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["delegateName", "categoryName", "dailyTargetWeightKg"]
    },
    "sales_entry": {
      "title": "Sales Entry",
      "description": "Sales entry made by delegates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "delegateName": { "type": "string" },
        "category": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "pieceWeight": { "type": "number" },
        "totalWeightKg": { "type": "number" },
        "timestamp": { "type": "string" },
        "dateStr": { "type": "string" }
      },
      "required": ["id", "delegateName", "category", "totalWeightKg"]
    },
    "inventory_item": {
      "title": "Inventory Item",
      "description": "Inventory stock items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryName": { "type": "string" },
        "productCode": { "type": "string" },
        "unitsInCarton": { "type": "string" },
        "productName": { "type": "string" },
        "piecesPerCarton": { "type": "string" },
        "todayInventoryCartons": { "type": "string" },
        "inventoryDate": { "type": "string" }
      },
      "required": ["id", "categoryName", "productName"]
    },
    "daily_evaluation": {
      "title": "Daily Evaluation Record",
      "description": "Saved daily evaluation snapshot for delegates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dateString": { "type": "string" },
        "delegateName": { "type": "string" },
        "totalScore": { "type": "number" },
        "totalWeightKg": { "type": "number" },
        "totalPieces": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "dateString", "delegateName", "totalScore"]
    },
    "damaged_product": {
      "title": "Damaged Product (QC)",
      "description": "Reports of damaged or defected products submitted by representatives for QC review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerCode": { "type": "string" },
        "customerName": { "type": "string" },
        "customerAddress": { "type": "string" },
        "customerType": { "type": "string", "enum": ["مفرد", "جملة"] },
        "productName": { "type": "string" },
        "productCode": { "type": "string" },
        "delegateName": { "type": "string" },
        "batchNumber": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "purchaseQuantity": { "type": "number" },
        "defectReason": { "type": "string" },
        "images": { "type": "array" },
        "status": { "type": "string", "enum": ["تم ارسال ايميل به", "تم تعويضه", "لم يتم تعويضه لحد الان", "تم رفض التعويض"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "customerCode", "customerName", "productName", "delegateName", "defectReason", "status"]
    },
    "app_setting": {
      "title": "App Setting",
      "description": "General application configuration such as working days",
      "type": "object",
      "properties": {
        "days": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    },
    "monthly_delegate_return": {
      "title": "Monthly Delegate Return",
      "description": "Monthly returns records per representative with shop count and returned weight in kg",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "delegateName": { "type": "string" },
        "shopsCount": { "type": "number" },
        "monthlyReturnedWeightKg": { "type": "number" },
        "monthString": { "type": "string" }
      },
      "required": ["id", "delegateName", "shopsCount", "monthlyReturnedWeightKg"]
    },
    "inventory_notification": {
      "title": "Inventory Notification & Log",
      "description": "Log of inventory uploads and newly restocked / arrived products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "number" },
        "dateFormatted": { "type": "string" },
        "uploaderName": { "type": "string" },
        "totalProductsCount": { "type": "number" },
        "restockedCount": { "type": "number" },
        "restockedProducts": { "type": "array" }
      },
      "required": ["id", "timestamp", "dateFormatted", "uploaderName", "totalProductsCount"]
    },
    "store_notification_read": {
      "title": "Store Notification Read State",
      "description": "Per-user tracking of the last time store inventory notifications were viewed",
      "type": "object",
      "properties": {
        "userKey": { "type": "string" },
        "userName": { "type": "string" },
        "lastReadTimestamp": { "type": "number" },
        "readAtIso": { "type": "string" }
      },
      "required": ["userKey", "lastReadTimestamp"]
    },
    "additional_target_delegate_config": {
      "title": "Additional Target Delegate Config",
      "description": "Targets and overrides for a delegate for ESL milk and Willie cheese",
      "type": "object",
      "properties": {
        "delegateName": { "type": "string" },
        "familyDailyWeightTargetKg": { "type": "number" },
        "familyTargetShopsCount": { "type": "number" },
        "familyMinWeightPerShopKg": { "type": "number" },
        "smallDailyWeightTargetKg": { "type": "number" },
        "smallTargetShopsCount": { "type": "number" },
        "smallMinWeightPerShopKg": { "type": "number" },
        "willieDailyWeightTargetKg": { "type": "number" },
        "willieTargetShopsCount": { "type": "number" },
        "willieMinWeightPerInvoiceKg": { "type": "number" },
        "willieMinWeightPerCustomerMonthKg": { "type": "number" },
        "manualSalesOverride": { "type": "object" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["delegateName"]
    },
    "uploaded_sales_entry": {
      "title": "Uploaded Sales Entry",
      "description": "Sales entry imported from Excel for additional target tracking",
      "type": "object",
      "properties": {
        "delegateName": { "type": "string" },
        "customerCode": { "type": "string" },
        "customerName": { "type": "string" },
        "productCode": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "totalWeightKg": { "type": "number" },
        "dateString": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["delegateName", "customerCode", "productCode", "dateString"]
    },
    "uploaded_willie_sales_entry": {
      "title": "Uploaded Willie Sales Entry",
      "description": "Willie cheese sales entry imported from Excel",
      "type": "object",
      "properties": {
        "delegateName": { "type": "string" },
        "customerCode": { "type": "string" },
        "customerName": { "type": "string" },
        "productCode": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "totalWeightKg": { "type": "number" },
        "dateString": { "type": "string" },
        "monthString": { "type": "string" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["delegateName", "customerCode", "productCode", "dateString"]
    },
    "product_customer_target": {
      "title": "Product Customer Target",
      "description": "Specific weight target for a product at a specific customer",
      "type": "object",
      "properties": {
        "delegateName": { "type": "string" },
        "customerCode": { "type": "string" },
        "customerName": { "type": "string" },
        "productCode": { "type": "string" },
        "productName": { "type": "string" },
        "targetWeightKg": { "type": "number" }
      },
      "required": ["delegateName", "customerCode", "productCode", "targetWeightKg"]
    }
  },
  "firestore": {
    "/store_notification_reads/{userId}": {
      "schema": "store_notification_read",
      "description": "Read status for store inventory notifications per user",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/inventory_notifications/{notificationId}": {
      "schema": "inventory_notification",
      "description": "Real-time sync of store inventory logs and newly arrived products",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/damaged_products/{productId}": {
      "schema": "damaged_product",
      "description": "Damaged products reported by representatives and QC status",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/delegate_targets/{targetId}": {
      "schema": "delegate_target",
      "description": "Sync target data for delegates and admin",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/sales_entries/{entryId}": {
      "schema": "sales_entry",
      "description": "Sync sales entries across devices",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/inventory_items/{itemId}": {
      "schema": "inventory_item",
      "description": "Sync daily inventory stock items",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/daily_evaluations/{evalId}": {
      "schema": "daily_evaluation",
      "description": "Saved daily evaluation records",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/app_settings/{settingId}": {
      "schema": "app_setting",
      "description": "General application settings such as remaining working days configuration",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/monthly_delegate_returns/{returnId}": {
      "schema": "monthly_delegate_return",
      "description": "Monthly delegate returns records",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/additional_targets_delegates/{configId}": {
      "schema": "additional_target_delegate_config",
      "description": "Delegate specific targets for ESL milk",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/additional_target_uploaded_sales/{entryId}": {
      "schema": "uploaded_sales_entry",
      "description": "Sales data uploaded from Excel for additional target tracking",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/product_customer_targets/{targetId}": {
      "schema": "product_customer_target",
      "description": "Product level targets for specific customers",
      "allow": {
        "read": "true",
        "write": "true"
      }
    },
    "/additional_target_willie_uploaded_sales/{entryId}": {
      "schema": "uploaded_willie_sales_entry",
      "description": "Willie cheese sales data uploaded from Excel",
      "allow": {
        "read": "true",
        "write": "true"
      }
    }
  }
}
